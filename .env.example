# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. See docs/configuration.md for the full guide.

# --- App ---
APP_NAME="Spinx App"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# --- Runtime driver: roadrunner | swoole ---
SPINX_DRIVER=roadrunner

# --- Database ---
# driver: pdo_sqlite (default, zero-config) | pdo_mysql | pdo_pgsql
DB_DRIVER=pdo_sqlite
DB_PATH=storage/database.sqlite
# Used when DB_DRIVER is pdo_mysql or pdo_pgsql instead of pdo_sqlite:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spinx
DB_USERNAME=root
DB_PASSWORD=

# --- Mail ---
# driver: smtp | ses | mailgun | resend  (see config/services.php)
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Third-party API credentials (see config/services.php) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_KEY=
STRIPE_SECRET=
RESEND_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# --- Security ---
# Comma-separated list of allowed CORS origins, or * for any (dev only —
# never use * in production if requests carry cookies/auth headers).
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_SECONDS=60

# --- Redis (Cache, Session, Queue, RateLimit) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# --- Session & Cache Drivers ---
# SESSION_DRIVER: file | database | redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
# CACHE_DRIVER: file | redis | array
CACHE_DRIVER=file

# --- Queue Driver ---
# QUEUE_CONNECTION: database | redis | sync
QUEUE_CONNECTION=database

# --- Real-Time Broadcasting (WebSockets) ---
# BROADCAST_DRIVER: log | pusher | null
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# --- Filesystem / Object Storage ---
# FILESYSTEM_DISK: local | s3
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=

# --- Semantic Vector Search ---
VECTOR_DRIVER=openai
VECTOR_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Application LLM / AI ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

