<?php

declare(strict_types=1);

use Spinx\Schedule\Scheduler;

/**
 * Copy to schedule.php (project root) to enable the task scheduler.
 * Then add ONE real OS cron entry — Spinx figures out what's actually
 * due each minute, same pattern Laravel's own scheduler uses:
 *
 *   * * * * * cd /path/to/your/app && php spinx schedule:run >> /dev/null 2>&1
 *
 * $container is the real, booted DI container — resolve any service
 * registered in config/container.php or any module.php from it the same
 * way a controller would receive it via constructor injection.
 *
 * IMPORTANT: schedule.php should NOT be gitignored — it contains
 * application logic (which tasks run when), not secrets. Same treatment
 * as Laravel's routes/console.php.
 */
return function (Scheduler $scheduler, $container): void {
