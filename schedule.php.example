    //         ->where('status', 'abandoned')
    //         ->whereNotNull('expires_at')
    //         ->delete();
    // }, 'prune abandoned orders')->hourly();

    // Every 15 minutes:
    // $scheduler->call(fn() => doSomething(), 'do something')->everyMinutes(15);

    // Every Monday at 08:30:
