{
    "name": "spinx/framework",
    "description": "A fast, lightweight PHP framework with enforced DDD architecture — flexible across persistent-process runtimes (RoadRunner, Swoole) without being tied to either.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "symfony/http-foundation": "^7.0",
        "symfony/routing": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/config": "^7.0",
        "doctrine/dbal": "^4.0",
        "vlucas/phpdotenv": "^5.6",
        "symfony/http-client": "^7.0",
        "symfony/mailer": "^7.2",
        "symfony/mailgun-mailer": "^7.2",
        "symfony/resend-mailer": "^7.2",
        "psr/http-message": "^2.0",
        "nyholm/psr7": "^1.8",
        "symfony/psr-http-message-bridge": "^7.0",
        "spiral/roadrunner-http": "^4.1",
        "spiral/roadrunner-worker": "^3.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11 || ^2.0",
        "symfony/var-dumper": "^7.0",
        "fakerphp/faker": "^1.23",
        "swoole/ide-helper": "^6.0",
        "spiral/roadrunner-cli": "^2.7"
    },
    "suggest": {
        "ext-swoole": "Enables the high-performance Swoole runtime driver (opt-in, Docker/Linux only — see spinx.json \"driver\": \"swoole\"). Not installable via Composer; use the project's Dockerfile or install the PECL extension directly."
    },
    "autoload": {
        "psr-4": {
            "Spinx\\": "src/Spinx/",
            "App\\Modules\\": "app/Modules/"
        },
        "files": [
            "src/Spinx/Support/helpers.php"
        ]
    },
    "bin": [
        "spinx"
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
